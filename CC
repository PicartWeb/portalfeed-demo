$notifStmt = $pdo->prepare("
  SELECT n.*, u.username, u.full_name, u.avatar
  FROM notifications n
  JOIN users u ON u.id = n.from_user_id
  WHERE n.to_user_id = :uid
  ORDER BY n.created_at DESC
  LIMIT 15
");
$notifStmt->execute([':uid' => $userId]);
