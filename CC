/* ========= FEED DATA ========= */

// posts with like counts + category
$stmt = $pdo->query("
  SELECT p.id, p.title, p.body, p.is_pinned, p.user_id, p.created_at, p.updated_at, p.category,
         u.username, u.full_name, u.avatar, u.role AS user_role,
         COALESCE(lc.like_count,0) AS like_count
  FROM posts p
  JOIN users u ON p.user_id = u.id
  LEFT JOIN (
    SELECT post_id, COUNT(*) AS like_count
    FROM post_likes
    GROUP BY post_id
  ) lc ON lc.post_id = p.id
  ORDER BY p.is_pinned DESC, p.created_at DESC
");
$posts = $stmt->fetchAll();

// comments for all posts
$postIds = array_column($posts, 'id');
$commentsByPost = [];
if (!empty($postIds)) {
    $in = implode(',', array_map('intval', $postIds));
    $cStmt = $pdo->query("
      SELECT c.id, c.post_id, c.body, c.user_id, c.created_at,
             u.username, u.full_name, u.avatar
      FROM comments c
      JOIN users u ON c.user_id = u.id
      WHERE c.post_id IN ($in)
      ORDER BY c.created_at ASC
    ");
    foreach ($cStmt as $row) {
        $commentsByPost[$row['post_id']][] = $row;
    }
}

// likes by current user
$likedPosts = [];
if (!empty($postIds)) {
    $likeStmt = $pdo->prepare("
      SELECT post_id FROM post_likes
      WHERE user_id = :uid
        AND post_id IN (" . implode(',', array_map('intval', $postIds)) . ")
    ");
    $likeStmt->execute([':uid' => $userId]);
    foreach ($likeStmt as $lp) {
        $likedPosts[(int)$lp['post_id']] = true;
    }
}